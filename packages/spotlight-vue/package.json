{
  "name": "@inupedia/spotlight-vue",
  "version": "0.7.7",
  "description": "Thin Vue runtime for Inupedia Spotlight Client Tools",
  "type": "module",
  "license": "MIT",
  "author": "inupedia",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./remote": {
      "types": "./dist/remote/index.d.ts",
      "import": "./dist/remote/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "import": "./dist/markdown/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/InspiraCardSpotlight": {
      "types": "./dist/components/InspiraCardSpotlight.vue.d.ts",
      "import": "./dist/components/InspiraCardSpotlight.js"
    },
    "./components/InspiraCardSpotlight.vue": {
      "types": "./dist/components/InspiraCardSpotlight.vue.d.ts",
      "import": "./dist/components/InspiraCardSpotlight.vue.js"
    },
    "./components/OfficialBorderBeam": {
      "types": "./dist/components/OfficialBorderBeam.vue.d.ts",
      "import": "./dist/components/OfficialBorderBeam.js"
    },
    "./components/OfficialBorderBeam.vue": {
      "types": "./dist/components/OfficialBorderBeam.vue.d.ts",
      "import": "./dist/components/OfficialBorderBeam.vue.js"
    },
    "./components/Live2dPanel.vue": {
      "types": "./dist/components/Live2dPanel.vue.d.ts",
      "import": "./dist/components/Live2dPanel.vue.js"
    },
    "./components/SpotlightCommandPanel.vue": {
      "types": "./dist/components/SpotlightCommandPanel.vue.d.ts",
      "import": "./dist/components/SpotlightCommandPanel.vue.js"
    },
    "./components/SpotlightMarkdownPreview.vue": {
      "types": "./dist/components/SpotlightMarkdownPreview.vue.d.ts",
      "import": "./dist/components/SpotlightMarkdownPreview.vue.js"
    },
    "./components/SpotlightRoot.vue": {
      "types": "./dist/components/SpotlightRoot.vue.d.ts",
      "import": "./dist/components/SpotlightRoot.vue.js"
    },
    "./components/SpotlightShell.vue": {
      "types": "./dist/components/SpotlightShell.vue.d.ts",
      "import": "./dist/components/SpotlightShell.vue.js"
    },
    "./components/SpotlightThinking.vue": {
      "types": "./dist/components/SpotlightThinking.vue.d.ts",
      "import": "./dist/components/SpotlightThinking.vue.js"
    },
    "./styles/spotlight-vue.css": "./dist/assets/spotlight-vue.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "dist/assets/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build:js": "vite build",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "build": "pnpm run clean && pnpm run build:js && pnpm run build:types && pnpm run verify:exports",
    "verify:exports": "node ../scripts/verify-package-exports.mjs --no-js-sourcemaps",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@inupedia/spotlight-client": "workspace:*",
    "@inupedia/spotlight-protocol": "workspace:*",
    "prettier": "^3.8.1",
    "yaml": "^2.8.4"
  },
  "peerDependencies": {
    "@inspira-ui/plugins": "^0.0.2",
    "md-editor-v3": "^5.0.0 || ^6.0.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@inspira-ui/plugins": {
      "optional": true
    },
    "@pixi-spine/all-3.8": {
      "optional": true
    },
    "pixi.js": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@pixi-spine/all-3.8": "^4.0.6",
    "pixi.js": "^8.9.2"
  },
  "devDependencies": {
    "@inspira-ui/plugins": "^0.0.2",
    "@vitejs/plugin-vue": "^6.0.3",
    "jsdom": "^27.4.0",
    "md-editor-v3": "^6.4.1",
    "pinia": "^3.0.4",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vue": "^3.5.26",
    "vue-tsc": "^3.2.2",
    "yaml": "^2.8.4"
  }
}
