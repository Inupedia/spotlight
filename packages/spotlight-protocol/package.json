{
  "name": "@inupedia/spotlight-protocol",
  "version": "0.7.7",
  "description": "Shared wire types for Inupedia Spotlight (client ↔ server)",
  "type": "module",
  "license": "MIT",
  "author": "inupedia",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./dist/spotlight-app.schema.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "build": "pnpm run clean && tsc -p tsconfig.json && node scripts/generate-schema.mjs && pnpm run verify:exports",
    "verify:exports": "node ../scripts/verify-package-exports.mjs",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
